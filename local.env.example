# This machine's settings for the scripts. Copy to local.env (not in git).

# other services that manage fans or power limits and must stop while
# t2opt-fand runs; they're restarted when it stops (t2fanrd always is)
# EXTRA_UNITS="my-powercap.service"

# what power-mode hands over to while t2opt-fand isn't running
# FALLBACK_CMD=/usr/local/bin/my-power-profile

# Touch Bar config whose power-mode button revert-to-t2fanrd.sh switches over
# to FALLBACK_CMD
# TOUCHBAR_CONFIG=$HOME/.config/tiny-dfr/config.toml
